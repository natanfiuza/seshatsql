{
  "name": "seshatsql",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente SQL desktop para MySQL — Electron + TypeScript + Vue 3",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json",
    "typecheck:web": "vue-tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack:win": "electron-builder --win --x64 --dir",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "ag-grid-community": "36.2.0",
    "ag-grid-vue3": "36.2.0",
    "monaco-editor": "0.57.0",
    "mysql2": "3.24.6",
    "vue": "3.5.44",
    "vue-i18n": "11.4.16",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14"
  }
}
